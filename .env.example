# ===================================================
# SupportIQ Environment Configuration Template
# Copy to .env and fill in environment-specific values.
# NEVER commit production secrets or credentials to git.
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# In development, if MONGODB_URI is left blank, SupportIQ automatically
# starts an embedded in-memory MongoDB server for testing.
# In production, set your MongoDB replica set or MongoDB Atlas URI:
MONGODB_URI=mongodb://localhost:27017/supportiq

# JWT & Session Security
# Provide a strong, cryptographically secure 32+ character secret
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32chars_minimum
JWT_EXPIRES_IN=7d

# Frontend Client URL (For CORS and redirect configuration)
CLIENT_URL=http://localhost:3000

# Administrator Bootstrap Credentials
# Used by "npm run setup-admin" or POST /api/auth/bootstrap-admin
BOOTSTRAP_SECRET=replace_with_secure_bootstrap_secret_token
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@supportiq.io
ADMIN_PASSWORD=replace_with_a_strong_admin_password_min_8_chars

# Optional External AI Integration
# If set, SupportIQ routes assistant prompts to Gemini Cloud AI.
# If unset, SupportIQ operates with its built-in rule-based triage engine.
GEMINI_API_KEY=
